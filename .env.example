# Configuración de Servidor Express
PORT=3000

# Configuración de Base de Datos PostgreSQL
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=joyas

# GEMINI_API_KEY (opcional para integraciones IA si aplica)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL
APP_URL="MY_APP_URL"
